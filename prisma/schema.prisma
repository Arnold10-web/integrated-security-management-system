  isSystemDefault   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contract {
  id                String   @id @default(cuid())
  contractCode      String   @unique
  title             String
  contractType      String
  partyName         String
  category          String
  startDate         String
  endDate           String
  valueUgx          Int?
  status            String   @default("Active")
  documentRef       String?
  managedBy         String?
  region            String?
  autoRenew         Boolean  @default(false)
  paymentTerms      String?
  billingCycle      String?
  slaTerms          String?
  notes             String?
  preparedBy        String?
  issuedBy          String?
  approvedBy        String?
  approvedAt        String?
  approvalStep      String?
  relatedGuardCode  String?
  relatedSiteName   String?
  voidReason        String?
  siteSurvey        String?
  siteSurveyBy      String?
  siteSurveyAt      String?
  createdBy         String?
  scanPages         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([endDate])
}
