  inspectionCode       String   @unique
  siteName             String
  supervisorName       String
  guardOnDuty          String
  inspectionTime       String
  radioCheckStatus     String
  uniformTurnout       String
  weaponEquipmentCheck String
  overallRating        String
  remarks              String
  createdAt            DateTime @default(now())
}

model AdminRequisition {
  id                String   @id @default(cuid())
  reqCode           String
  department        String
  requestedBy       String
  itemDescription   String
  quantity          Int
  estimatedCostUgx  Float
  priority          String   @default("Medium")
  status            String   @default("Pending Approval")
  dateRequested     String
  approvedBy        String?
  approvedAt        String?
  rejectedBy        String?
