generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * Roles are stored as free-form strings on User.role (validated against the
 * 23-role UserRole union in src/types.ts). No UserRole Prisma enum is used —
 * the legacy enum (with Marketing_Supervisor / Assistant_Accountant_1/2) was
 * removed as dead code in the v2.7 doc/system alignment.
 */
enum GuardLifecycleStage {
  ENROLLED
  HANDED_TO_OPERATIONS
  IN_TRAINING
  PASSED_OUT
  DEPLOYED
}

enum GuardStatus {
  On_Duty   @map("On Duty")
  Off_Duty  @map("Off Duty")
  On_Leave  @map("On Leave")
  Suspended
  Deserted
  Archived
}

enum LeaveStatus {
  Pending_Regional_Approval @map("Pending Regional Approval")
  Pending_HR_Approval       @map("Pending HR Approval")
  Pending_GM_Approval       @map("Pending GM Approval")
  Approved
  Rejected
  Completed
}

enum ContractStatus {
  Draft
  Active
  Expiring_Soon   @map("Expiring Soon")
  Expired
  Pending_Renewal @map("Pending Renewal")
  Terminated
  Archived
}

enum GuardDesignation {
  Guard
  K9_Handler     @map("K9 Handler")
  Armorer
  Site_In_Charge @map("Site In-Charge")
  Inspector
}

enum ArmouryCondition {
  Excellent
  Good
  Requires_Service @map("Requires Service")
  Decommissioned
}

enum VehicleStatus {
  Operational
  In_Service     @map("In Service")
  Fueling_Needed @map("Fueling Needed")
  Grounded
}

enum SlaStatus {
  Compliant
  Understaffed
  Attention_Needed @map("Attention Needed")
}

enum InvoiceStatus {
  Draft
  Pending
  PendingGMApproval @map("Pending GM Approval")
  Sent
  Paid
  Overdue
  Cancelled
}

enum IncidentStatus {
  Open
  UnderInvestigation @map("Under Investigation")
  Escalated
  Resolved
  Closed
}

enum DeploymentOrderStatus {
  Open
  InProgress @map("In Progress")
  Fulfilled
  Cancelled
  Assigned
  Filled
}

enum DutyRosterStatus {
  Scheduled
  CheckedIn  @map("Checked In")
  CheckedOut @map("Checked Out")
  Absent
  Cancelled
  Present
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              String
  department        String
  region            String?
  forceNumber       String?   @unique
  phone             String?
  avatarUrl         String?
  lastActive        DateTime  @default(now())
  status            String    @default("Active")
  customPermissions Json? // Per-user module access overrides: { moduleName: "view" | "full" | "none" }
  // Time-bound delegation (§5.4): IT Officer grants a temporary elevated role.
  actingRole        String? // effective role while acting (resolved at login)
  actingExpiresAt   DateTime? // role falls back to base once past this
  actingGrantedBy   String? // name of the IT Officer who granted it
  actingGrantedAt   DateTime? // delegation grant time
  // Staff identity card (plastic) — same lifecycle as guard paper IDs.
  idCardStatus             String?
  idCardNumber             String?
  idCardIssuedDate         String?
  idCardExpiryDate         String?
  idCardIssuerName         String?
  idCardIssuerSignatureUrl String?
  // Staff biodata — captured the same way as guard biodata (§HR personnel).
  photoUrl                String?
  signatureUrl            String?
  dateOfBirth             String?
  gender                  String?
  maritalStatus           String?
  educationLevel          String?
  motherName              String?
  motherPhone             String?
  fatherName              String?
  fatherPhone             String?
  nextOfKinName           String?
  nextOfKinRelationship   String?
  nextOfKinPhone          String?
  nextOfKinResidence      String?
  relativesOrReferees     String?
  residenceDistrict       String?
  residenceSubCounty      String?
  residenceParish         String?
  residenceVillage        String?
  lc1Chairperson          String?
  lc1Contact              String?
  physicalAddress         String?
  emergencyContactPhone   String?
  surnameAtBirth          String?
  nationality             String?
  tribe                   String?
  placeOfBirth            String?
  lc2Chairperson          String?
  closeRelatives          String[]
  neighbours              String[]
  fatherAlive             Boolean  @default(false)
  fatherResidence         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions UserSession[]
}

model Region {
  id          String           @id @default(cuid())
  name        String           @unique
  code        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  offices     RegionalOffice[]
}

model RegionalOffice {
  id                  String   @id @default(cuid())
  regionId            String
  region              Region   @relation(fields: [regionId], references: [id])
  code                String   @unique
  name                String
  locationCity        String
  regionalManagerName String
  phone               String
  email               String
  activeGuardsCount   Int      @default(0)
  clientSitesCount    Int      @default(0)
  armouryVaultStatus  String   @default("Fully Operational")
  vehiclesAssigned    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Guard {
  id                       String              @id @default(cuid())
  forceNumber              String              @unique // canonical unique identifier (force/PSG number)
  fullName                 String
  photoUrl                 String?
  signatureUrl             String?
  designation              GuardDesignation    @default(Guard)
  phone                    String
  nationalId               String
  tin                      String?
  nssfNo                   String?
  assignedSite             String
  location                 String?
  bankAccount              String?
  bankName                 String?
  finishedProbation        Boolean             @default(false)
  status                   String              @default("Off Duty")
  lifecycleStage           GuardLifecycleStage @default(ENROLLED)
  isDeserter               Boolean             @default(false)
  desertionDate            DateTime?
  desertionNotes           String?
  medicalCleared           Boolean             @default(false)
  armedQualified           Boolean             @default(false)
  k9Qualified              Boolean             @default(false)
  joinDate                 DateTime            @default(now())
  region                   String?
  zone                     String?
  warningLettersCount      Int                 @default(0)
  certifications           String[]
  terminationReason        String?
  terminationDate          String?
  terminationCategory      String?
  idCardStatus             String?
  idCardNumber             String?
  idCardIssuedDate         String?
  idCardExpiryDate         String?
  idCardIssuerName         String?
  idCardIssuerSignatureUrl String?
  hasSystemAccount         Boolean             @default(false)
  linkedUserId             String?
  dateOfBirth              String?
  gender                   String?
  maritalStatus            String?
  educationLevel           String?
  motherName               String?
  motherPhone              String?
  fatherName               String?
  fatherPhone              String?
  nextOfKinName            String?
  nextOfKinRelationship    String?
  nextOfKinPhone           String?
  nextOfKinResidence       String?
  relativesOrReferees      String?
  residenceDistrict        String?
  residenceSubCounty       String?
  residenceParish          String?
  residenceVillage         String?
  lc1Chairperson           String?
  lc1Contact               String?
  physicalAddress          String?
  emergencyContactPhone    String?
  surnameAtBirth           String?
  nationality              String?
  tribe                    String?
  placeOfBirth             String?
  lc2Chairperson           String?
  closeRelatives           String[]
  neighbours               String[]
  fatherAlive              Boolean             @default(false)
  fatherResidence          String?
  bankAccountName          String?
  bankBranch               String?
  biodata                  GuardBiodata?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([region])
  @@index([status])
  @@index([lifecycleStage])
  @@index([forceNumber])
}

model GuardBiodata {
  id                    String    @id @default(cuid())
  guardId               String    @unique
  guard                 Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  // PII / biodata — restricted to HR/Records reads (see Guard model comment)
  dateOfBirth           DateTime?
  gender                String?
  maritalStatus         String?
  nationality           String?
  tribe                 String?
  placeOfBirth          String?
  educationLevel        String?
  motherName            String?
  motherPhone           String?
  fatherName            String?
  fatherPhone           String?
  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?
  nextOfKinResidence    String?
  relativesOrReferees   String?
  residenceDistrict     String?
  residenceSubCounty    String?
  residenceParish       String?
  residenceVillage      String?
  lc1Chairperson        String?
  lc1Contact            String?
  physicalAddress       String?
  emergencyContactPhone String?
  surnameAtBirth        String?
  lc2Chairperson        String?
  closeRelatives        String[]
  neighbours            String[]
  fatherAlive           Boolean?
  fatherResidence       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model DisciplinaryAction {
  id                   String   @id @default(cuid())
  actionCode           String   @unique
  guardId              String
  guardName            String
  forceNumber          String
  actionType           String
  reason               String
  severity             String   @default("Medium")
  status               String   @default("Initiated")
  initiatedBy          String
  regionalApprovedBy   String?
  operationsApprovedBy String?
  hrApprovedBy         String?
  approvedAt           String?
  linkedIncidentCode   String?
  linkedComplaintCode  String?
  offenceCategory      String?
  offence              String?
  offenceDate          String?
  offenceTime          String?
  zone                 String?
  actionTaken          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Complaint {
  id                       String   @id @default(cuid())
  complaintCode            String   @unique
  clientName               String
  siteName                 String
  category                 String
  description              String
  satisfactionRating       Int?
  status                   String   @default("Open")
  ownedBy                  String   @default("Marketing")
  resolvedBy               String?
  resolutionNotes          String?
  referredForInvestigation Boolean  @default(false)
  linkedIncidentCode       String?
  reportedDate             String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ClientSite {
  id                  String    @id @default(cuid())
  clientName          String
  siteName            String
  location            String
  zone                String
  dayShiftGuards      Int       @default(0)
  nightShiftGuards    Int       @default(0)
  dayShiftArmed       Int       @default(0)
  nightShiftArmed     Int       @default(0)
  armedGuardsRequired Int       @default(0)
  k9Required          Boolean   @default(false)
  contactPerson       String
  contactPhone        String
  slaStatus           SlaStatus @default(Compliant)
  region              String?
  satisfactionRating  Int?
  deploymentStatus    String    @default("Not Deployed")
  wonBy               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([region])
  @@index([slaStatus])
  @@index([siteName])
  @@index([clientName])
  @@index([deploymentStatus])
}

model ArmouryItem {
  id                  String           @id @default(cuid())
  assetTag            String
  serialNumber        String
  category            String
  name                String
  caliberOrSpecs      String
  totalQuantity       Int
  availableQuantity   Int
  condition           ArmouryCondition @default(Good)
  assignedToGuardId   String?
  assignedToGuardName String?
  location            String           @default("Main Vault")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([category])
  @@index([condition])
  @@index([location])
  @@index([assignedToGuardId])
  @@index([serialNumber])
}

model ArmouryLog {
  id                  String   @id @default(cuid())
  serialNumberLog     String
  guardId             String
  guardName           String
  locationName        String
  firearmSerialNumber String
  assetName           String
  assetTag            String
  ammoRoundsOut       Int
  dateOut             String
  timeOut             String
  signOutConfirmed    Boolean
  dateIn              String?
  timeIn              String?
  ammoRoundsIn        Int?
  signInConfirmed     Boolean?
  substituteReceiver  String?
  armourerInCharge    String
  status              String   @default("Checked Out")
  notes               String?
  createdAt           DateTime @default(now())

  @@index([guardId])
  @@index([locationName])
  @@index([status])
  @@index([dateOut])
}

model K9Dog {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  breed               String
  chipNumber          String
  ageYears            Int
  status              String   @default("Active Duty")
  assignedHandlerId   String?
  assignedHandlerName String?
  kennelNumber        String
  rabiesVaccineDate   String
  lastVetCheck        String
  specialization      String
  currentWeightKg     Float?
  healthCondition     String?
  vaccinationStatus   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([breed])
  @@index([assignedHandlerId])
}

model K9HealthInspection {
  id                   String   @id @default(cuid())
  inspectionCode       String   @unique
  k9Id                 String
  k9Name               String
  handlerName          String
  inspectionDate       String
  weightKg             Float
  vaccinationStatus    String
  physicalCondition    String
  coatAndSkinCheck     String
  appetiteAndHydration String
  temperatureCelsius   Float?
  inspectingOfficer    String
  notes                String?
  createdAt            DateTime @default(now())
}

model K9Log {
  id             String   @id @default(cuid())
  k9Id           String
  k9Name         String
  handlerName    String
  siteName       String
  deploymentDate String
  shiftType      String
  trainingScore  String
  vetNotes       String?
  createdAt      DateTime @default(now())

  @@index([k9Id])
  @@index([siteName])
  @@index([deploymentDate])
}

model Vehicle {
  id                      String        @id @default(cuid())
  plateNumber             String        @unique
  vehicleType             String
  makeModel               String
  driverAssigned          String
  fuelLevelPercentage     Int           @default(100)
  mileageKm               Int           @default(0)
  status                  VehicleStatus @default(Operational)
  lastServiceDate         String
  nextServiceDueKm        Int
  chassisNumber           String?
  insuranceExpiryDate     String?
  roadLicenceExpiryDate   String?
  deploymentBranch        String?
  conditionRating         String?
  replacementStatus       String?
  gpsTrackerId            String?
  lifetimeMaintenanceCost Float?
  serviceIntervalKm       Int?
  lastOilChangeKm         Int?
  lastOilChangeDate       String?
  oilStatus               String?
  lastTyreCheckDate       String?
  tyreTreadDepthMm        Float?
  tyreStatus              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([status])
  @@index([deploymentBranch])
  @@index([driverAssigned])
}

model VehicleTripLog {
  id             String   @id @default(cuid())
  tripCode       String   @unique
  vehicleId      String
  plateNumber    String
  driverName     String
  destination    String
  purpose        String
  startMileageKm Int
  endMileageKm   Int?
  distanceKm     Int?
  departureTime  String
  arrivalTime    String?
  status         String   @default("In Transit")
  authorizedBy   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([departureTime])
}

model FuelLog {
  id                String   @id @default(cuid())
  voucherCode       String   @unique
  vehicleId         String
  plateNumber       String
  driverName        String
  fuelLitres        Float
  costUgx           Float
  mileageAtRefillKm Int
  fuelType          String
  stationName       String
  refillDate        String
  approvedBy        String?
  reconciled        Boolean  @default(false)
  status            String   @default("Pending FM Approval")
  approvedAt        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MaintenanceServiceLog {
  id                 String   @id @default(cuid())
  serviceCode        String   @unique
  vehicleId          String
  plateNumber        String
  serviceType        String
  description        String
  mileageAtServiceKm Int
  serviceDate        String
  nextDueDate        String
  costUgx            Float
  workshopName       String
  status             String   @default("Scheduled")
  approvalStatus     String   @default("Pending FM Approval")
  approvedBy         String?
  approvedAt         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Driver {
  id                   String   @id @default(cuid())
  driverCode           String   @unique
  forceNumber          String?  @unique
  roleType             String   @default("Driver")
  fullName             String
  contactPhone         String?
  nationalId           String?
  licenceNumber        String
  licenceClass         String
  licenceExpiryDate    String
  assignedVehiclePlate String
  dutyShift            String
  safetyScorePct       Float
  totalTripsCompleted  Int
  trainingBadges       String[]
  sourceRef            String?
  approvedBy           String?
  approvedAt           String?
  status               String   @default("Pending FM Approval")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model DailyVehicleInspection {
  id                String   @id @default(cuid())
  inspectionCode    String   @unique
  vehicleId         String
  plateNumber       String
  inspectorDriver   String
  inspectionDate    String
  inspectionTime    String
  brakesCheck       String
  tyresCheck        String
  lightsSirensCheck String
  oilLevelCheck     String
  coolantCheck      String
  batteryCheck      String
  overallCondition  String
  defectsNoted      String
  createdAt         DateTime @default(now())
}

model FleetBreakdownEmergency {
  id                      String   @id @default(cuid())
  incidentCode            String   @unique
  vehicleId               String
  plateNumber             String
  driverName              String
  location                String
  issueType               String
  description             String
  reportedTime            String
  recoveryAssigned        String
  backupVehicleDispatched String?
  status                  String   @default("Active Emergency")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Incident {
  id               String         @id @default(cuid())
  incidentCode     String         @unique
  title            String
  siteName         String
  reportedByGuard  String
  incidentDate     DateTime       @default(now())
  category         String
  severity         String
  description      String
  status           IncidentStatus @default(Open)
  evidenceAttached Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([siteName])
  @@index([status])
  @@index([severity])
  @@index([incidentDate])
  @@index([category])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientName    String
  siteName      String
  date          DateTime      @default(now())
  dueDate       DateTime
  amount        Float
  status        InvoiceStatus @default(Draft)
  itemsCount    Int           @default(0)
  approvedBy    String?
  approvedAt    DateTime?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([clientName])
  @@index([dueDate])
}

model Reminder {
  id            String   @id @default(cuid())
  invoiceId     String
  invoiceNumber String
  clientName    String
  channel       String
  recipient     String
  status        String
  reason        String?
  message       String
  triggeredBy   String
  createdAt     DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  targetRole String?
  type       String
  title      String
  message    String
  module     String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([targetRole])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  date        String
  status      String   @default("Pending")
  approvedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CashierTransaction {
  id           String    @id @default(cuid())
  guardName    String
  forceNumber  String
  type         String
  amount       Float
  date         String
  status       String    @default("Pending Approval")
  processedBy  String
  guardId      String?
