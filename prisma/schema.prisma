  @@index([status])
  @@index([region])
}

model SiteDeployment {
  id             String   @id @default(cuid())
  deploymentCode String   @unique
  siteId         String
  siteName       String
  clientName     String
  guardId        String
  guardName      String
  shiftType      String
  deployedBy     String
  deployedAt     String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DeploymentOrder {
  id                String                @id @default(cuid())
  orderCode         String                @unique
  siteId            String
  siteName          String
  clientName        String
  region            String?
  requiredHeadcount Int
