model RecruitTrainee {
  id                  String   @id @default(cuid())
  traineeCode         String
  fullName            String
  nationalIdNumber    String
  age                 Int
  cohortId            String
  cohortName          String
  assignedRegion      String
  drillScore          Float    @default(0)
  marksmanshipScore   Float    @default(0)
