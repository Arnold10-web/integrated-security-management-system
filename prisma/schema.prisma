model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userName  String
  userRole  String
  action    String
  module    String
  details   String
  ipAddress String? // captured from X-Forwarded-For / remoteAddress for IT traceability
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([ipAddress])
  @@index([timestamp])
}

// Time-bound delegation request (§11): HR Manager initiates — who needs
// coverage, for which role, and why; IT Officer executes on that request.
model ActingPrivilegeRequest {
  id              String    @id @default(cuid())
  targetUserId    String // user needing coverage
  targetName      String
  actingRole      String // the role to be covered
  reason          String // why coverage is needed
  expiresAt       DateTime // coverage expiry
  status          String    @default("Pending") // Pending | Granted | Denied | Cancelled
  requestedById   String // HR Manager who initiated
  requestedByName String
  grantedById     String? // IT Officer who executed
  grantedByName   String?
  grantedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([requestedById])
  @@index([targetUserId])
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  role           String
  ipAddress      String
  userAgent      String?   @db.Text
  device         String? // Desktop | Mobile | Tablet | Unknown
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  country        String?
  city           String?
  loginAt        DateTime  @default(now())
  lastActiveAt   DateTime  @default(now()) @updatedAt
  logoutAt       DateTime?
  isActive       Boolean   @default(true)
  tokenId        String? // first 8 chars of JWT for correlation without storing full token

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([isActive])
  @@index([loginAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  userAgent String?  @db.Text
  success   Boolean
  reason    String? // Invalid credentials, Suspended, etc.
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([success])
  @@index([createdAt])
}

model ITServer {
  id          String   @id @default(cuid())
  name        String
  ipAddress   String
  status      String   @default("Operational")
  cpuUsage    Float    @default(0)
  memoryUsage Float    @default(0)
  uptime      String   @default("0d 0h 0m")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ITSupportTicket {
  id          String   @id @default(cuid())
  ticketCode  String   @unique
  reportedBy  String
  subject     String
  priority    String   @default("Medium")
  status      String   @default("Open")
  createdDate String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ITAsset {
  id                        String   @id @default(cuid())
  assetCode                 String   @unique
  name                      String
  category                  String
  serialNumberOrKey         String
  assignedToPersonOrStation String
  assignedDepartment        String
  purchaseDate              String
  warrantyExpiryDate        String?
  valueUgx                  Float
  condition                 String   @default("Operational")
  softwareVersionOrSpecs    String?
  ipAddressOrHost           String?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model LeaveRequest {
  id              String   @id @default(cuid())
  guardId         String
  guardName       String
  forceNumber     String
  leaveType       String
  startDate       String
  endDate         String
  durationDays    Int
  reason          String
  reliefGuardName String?
  reliefForceNumber String?
  appliedDate     String
  status          String   @default("Pending Regional Approval")
  approvedBy      String?
  notes           String?
  contactAddress  String?
  entitlement     Int?
  taken           Int?
  balance         Int?
  resumptionDate  String?
  gmApprovedBy    String?
  approvalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Workflow {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  module      String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       WorkflowStep[]
}

model WorkflowStep {
  id              String   @id @default(cuid())
  workflowId      String
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder       Int
  name            String
  approverRole    String
  approverRoles   String? // JSON array of alternative approver roles; falls back to [approverRole]
  optional        Boolean  @default(false) // skipped when the reference opts out (meta.excludeOptional / skipOptionalStepOrders)
  regionScoped    Boolean  @default(false) // approver must belong to the approval's regionScope
  condition       String? // JSON condition e.g. {"valueField":"amount","gte":100000000}
  escalationHours Int?
  createdAt       DateTime @default(now())
}

model Approval {
  id              String           @id @default(cuid())
  workflowId      String
  workflowCode    String
  referenceType   String
  referenceId     String
  currentStep     Int              @default(1)
  totalSteps      Int              @default(1)
  status          String           @default("Pending")
  requestedBy     String
  requestedByName String
  regionScope     String? // required when any step is regionScoped
  decidedBy       String?
  decidedAt       DateTime?
  meta            String? // JSON: { excludeOptional?: boolean, skipOptionalStepOrders?: number[] }
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  actions         ApprovalAction[]
}

model TransportRequest {
  id                  String   @id @default(cuid())
  requestCode         String   @unique
  requestedBy         String
  requestedByName     String
  requesterDepartment String
  destination         String
  purpose             String
  travelDate          String
  travelTime          String?
  returnTime          String?
  vehicleType         String   @default("Any") // Car | Motorcycle | Any
  passengersCount     Int      @default(1)
  status              String   @default("Pending Fleet") // Pending Fleet | Approved | Declined
  assignedVehicleId   String?
  assignedVehicle     String?
  assignedDriverId    String?
  assignedDriver      String?
  assignedRiderId     String?
  assignedRider       String?
  declinedReason      String?
  actedBy             String?
  actedAt             String?
  approvalId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ApprovalAction {
  id         String    @id @default(cuid())
  approvalId String
  approval   Approval  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  stepOrder  Int
  actorRole  String
  actorName  String?
  action     String?
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime  @default(now())
}

model Document {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  category      String
  referenceType String
  referenceId   String
  mimeType      String
  fileSize      Int
  filePath      String
  checksum      String? // SHA-256 for dedup/integrity
  uploadedBy    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([referenceType, referenceId])
  @@index([uploadedBy])
}

model JobPosting {
  id             String      @id @default(cuid())
  code           String      @unique
  title          String
  department     String
  location       String
  description    String
  requirements   String
  positionsCount Int         @default(1)
  salaryRange    String?
  status         String      @default("Open")
  postedDate     String
  closesDate     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  candidates     Candidate[]
}

model Candidate {
  id                String     @id @default(cuid())
  jobPostingId      String
  jobPosting        JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  fullName          String
  email             String
  phone             String
  resumePath        String?
  coverLetter       String?
  source            String?
  roleType          String?
  licenceNumber     String?
  licenceClass      String?
  licenceExpiryDate String?
  nationalId        String?
  status            String     @default("New")
  appliedDate       String
  interviewDate     String?
  interviewScore    Float?
  notes             String?
  gender            String?
  age               String?
  address           String?
  expectedSalary    Float?
  availability      String?
  education         String?
  certifications    String?
  yearsExperience   Int?
  employerHistory   String?
  reasonForLeaving  String?
  interviewScores   Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model PerformanceReview {
  id                    String   @id @default(cuid())
  guardId               String
  guardName             String
  forceNumber           String
  reviewPeriod          String
  reviewType            String
  evaluatorName         String
  evaluationDate        String
  disciplineScore       Float
  punctualityScore      Float
  clientRatingScore     Float
  appearanceScore       Float
  incidentHandlingScore Float
  overallRating         String
  recommendation        String
  comments              String?
  keyStrengths          String?
  growthAreas           String?
  developmentGoals      String?
  status                String   @default("Draft")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CustomRoleDefinition {
  id              String   @id @default(cuid())
  roleName        String   @unique
  department      String
  description     String?
  allowedModules  String[]
  assignedRegions String[]
  createdBy       String
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contract {
  id               String               @id @default(cuid())
  contractCode     String               @unique
  title            String
  contractType     String
  partyName        String
  category         String
  startDate        DateTime
  endDate          DateTime
  valueUgx         Int?
  status           String               @default("Active")
  documentRef      String?
  managedBy        String?
  region           String?
  autoRenew        Boolean              @default(false)
  paymentTerms     String?
  billingCycle     String?
  slaTerms         String?
  notes            String?
  preparedBy       String?
  issuedBy         String?
  approvedBy       String?
  approvedAt       String?
  approvalStep     String?
  relatedForceNumber String?
  relatedSiteName  String?
  voidReason       String?
  siteSurvey       String?
  siteSurveyBy     String?
  siteSurveyAt     String?
  createdBy        String?
  scanPages        Json?
  // ── E-Contracts extension (scoped to ISCMS Contract lifecycle) ──
  templateId       String?
  templateBody     String? // snapshot copied at signing-request creation time — immutable after
  documentHash     String? // SHA-256 of compiledHtml + signature + contractId (tamper evidence)
  finalizedPdfPath String? // absolute path under secure_storage/
  isArchived       Boolean              @default(false)
  archivedAt       DateTime?
  template         ContractTemplate?    @relation(fields: [templateId], references: [id])
  signers          ContractSigner[]
  esignAuditLogs   ContractEsignAudit[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([endDate])
  @@index([region])
  @@index([status])
  @@index([templateId])
}

model ContractTemplate {
  id        String     @id @default(cuid())
  name      String
  bodyHtml  String     @db.Text
  version   Int        @default(1)
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]
}

model ContractSigner {
  id            String    @id @default(cuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  secureToken   String    @unique
  signerEmail   String // encrypted at rest via app-level AES (DB_ENCRYPTION_KEY) — see esignSecurity.ts
  signerName    String?
  variableData  Json? // JSON is encrypted at rest via same key when non-empty
  signatureData String?   @db.Text
  isCompleted   Boolean   @default(false)
  signedAt      DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([contractId])
  @@index([secureToken])
  @@index([expiresAt])
}

model ContractEsignAudit {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  eventType  String
  ipAddress  String?
  userAgent  String?  @db.Text
  cryptoHash String?
  createdAt  DateTime @default(now())

  @@index([contractId])
}

model ForceNumberSequence {
  year      String   @id // "025" etc — year suffix
  nextSeq   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?   @db.Text
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

model SiteSurvey {
  id                    String   @id @default(cuid())
  surveyCode            String   @unique
  clientName            String
  siteName              String
  region                String?
  status                String   @default("Requested") // Requested → In Progress → Completed
  requestedBy           String
  requestedByName       String
  requestedDepartment   String
  surveyedBy            String?
  premisesType          String?
  perimeterStatus       String?
  entryPoints           Int?
  riskLevel             String?
  highValueAssets       String?
  dayGuardsNeeded       Int?
  nightGuardsNeeded     Int?
  armedDay              Boolean?
  armedNight            Boolean?
  equipmentNeeded       String?
  k9Required            Boolean?
  patrolVehicleRequired Boolean?
  accessHours           String?
  recommendation        String?
  notes                 String?
  reportPath            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ContractInquiry {
  id                  String   @id @default(cuid())
  inquiryCode         String   @unique
  requestedBy         String
  requestedByName     String
  requesterDepartment String
  clientName          String
  siteName            String?
  searchHints         String?
  purpose             String   @default("Confirmation") // Confirmation | Full Copy
  status              String   @default("Pending") // Pending → Answered
  respondedBy         String?
  responseType        String? // Confirmation | Full Copy
  responseNotes       String?
  responsePath        String?
  respondedAt         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
