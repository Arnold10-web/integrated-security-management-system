}

model Lead {
  id              String    @id @default(cuid())
  companyName     String
  contactPerson   String
  email           String
  phone           String
  estimatedValue  Float
  source          String    @default("Manual")
  stage           String    @default("New")
  assignedTo      String
  ownerId         String?
  region          String?
  wonBy           String?
