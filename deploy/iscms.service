[Unit]
Description=ISCMS - Integrated Security Company Management System
After=network.target postgresql.service

[Service]
Type=simple
User=iscms
WorkingDirectory=/opt/iscms
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/iscms/dist/server.js
Restart=always
RestartSec=3
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
